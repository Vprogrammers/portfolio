{# The company a project was delivered with: its round mark, its name and the kind of engagement. #}
<p class="a-employer">
	<span class="a-employer__mark" aria-hidden="true">{{ name|slice(0, 1) }}</span>
	<span class="a-employer__text"><b>{{ label }} {{ name }}</b><small>{{ note }}</small></span>
</p>
