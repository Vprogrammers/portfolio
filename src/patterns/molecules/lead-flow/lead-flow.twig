{# BezBrige! agent story on one phone: the admin assigns a new contact, the agent calls, sets the call status and awareness level, adds a reminder, and the contact ends as a signed contract on the agent's stats. An awareness ladder beside the phone shows the client's stage. Fills its positioned parent. #}
<div class="m-lead-flow" aria-hidden="true">
	<div class="m-lead-flow__stage">
		<div class="m-lead-flow__device">
			<div class="m-lead-flow__screen">
				<div class="m-lead-flow__header">
					<div class="m-lead-flow__status"><span>9:41</span><i class="m-lead-flow__island"></i><span class="m-lead-flow__bars"></span></div>
					<span class="m-lead-flow__avatar">{{ agent.initials }}</span>
					<img class="m-lead-flow__logo" src="{{ logo }}" alt="" loading="lazy" decoding="async">
					<i class="m-lead-flow__search"></i>
				</div>

				{# 1. Home: the contact list, where the new contact lands. #}
				<div class="m-lead-flow__scene m-lead-flow__scene--home">
					<p class="m-lead-flow__section">Novi kontakti</p>
					<div class="m-lead-flow__row m-lead-flow__row--new" style="--accent: #d31620"><span><b>{{ client.name }} ({{ client.age }})</b><small>{{ client.product }} · Klijent nije pozvan</small></span><i class="m-lead-flow__call"></i></div>
					<p class="m-lead-flow__section">Ostali kontakti</p>
					{% for contact in contacts %}
						<div class="m-lead-flow__row" style="--accent: {{ contact.color }}"><span><b>{{ contact.name }} ({{ contact.age }})</b><small>{{ contact.product }} · {{ contact.status }}</small></span><i class="m-lead-flow__call"></i></div>
					{% endfor %}
				</div>

				{# 2. The contact's detail, where the work happens. #}
				<div class="m-lead-flow__scene m-lead-flow__scene--detail">
					<p class="m-lead-flow__name">{{ client.name }}</p>
					<p class="m-lead-flow__badge">
						<em style="--badge: #d31620">Klijent nije pozvan</em>
						<em style="--badge: #9a6f01">Zainteresovan/a</em>
						<em style="--badge: #9a6f01">Poslao/la ponudu</em>
						<em style="--badge: #656244">Potpisan ugovor</em>
					</p>
					<dl class="m-lead-flow__facts">
						<div><dt>Telefon</dt><dd>{{ client.phone }}</dd></div>
						<div><dt>Proizvod</dt><dd>{{ client.product }}</dd></div>
						<div><dt>Trajanje</dt><dd>{{ client.duration }}</dd></div>
						<div><dt>Iznos</dt><dd>{{ client.amount }}</dd></div>
						<div class="m-lead-flow__awareness"><dt>Nivo svesnosti</dt><dd>{% for level in [1, 3, 4] %}<span>{{ level }} · {{ awareness[level] }}</span>{% endfor %}</dd></div>
					</dl>
					<p class="m-lead-flow__reminder"><span><small>{{ reminder.when }}</small>{{ reminder.text }}</span><i></i></p>
					<p class="m-lead-flow__contract">{{ contract }}</p>
					<div class="m-lead-flow__actions">
						<span style="--button: #000019">Arhiviraj</span>
						<span style="--button: #9a6f01">Status</span>
						<span style="--button: #3a1772">Podsetnik</span>
						<span style="--button: #656244">Pozovi</span>
					</div>
				</div>

				{# The call. #}
				<div class="m-lead-flow__scene m-lead-flow__scene--call">
					<span class="m-lead-flow__caller">{{ client.name|slice(0, 1) }}</span>
					<p class="m-lead-flow__calling">Pozivam…</p>
					<p class="m-lead-flow__name">{{ client.name }}</p>
					<p class="m-lead-flow__calling">{{ client.phone }}</p>
					<i class="m-lead-flow__hangup"></i>
				</div>

				{# The call status dialog. #}
				<div class="m-lead-flow__dialog">
					<div class="m-lead-flow__sheet">
						{% for status in statuses %}<p>{{ status }}<i></i></p>{% endfor %}
						<span class="m-lead-flow__save">Sačuvaj</span>
					</div>
				</div>

				{# 3. The agent's profile with the new contract counted. #}
				<div class="m-lead-flow__scene m-lead-flow__scene--profile">
					<span class="m-lead-flow__me">{{ agent.initials }}</span>
					<p class="m-lead-flow__name">{{ agent.name }}</p>
					<p class="m-lead-flow__level">{{ agent.level }}</p>
					<dl class="m-lead-flow__stats">
						{% for stat in agent.stats %}
							<div><dt>{{ stat.label }}</dt><dd><span>{{ stat.before }}</span><span>{{ stat.after }}</span></dd></div>
						{% endfor %}
					</dl>
				</div>

				<div class="m-lead-flow__push">
					<span class="m-lead-flow__app-icon"><img src="{{ logo }}" alt="" loading="lazy" decoding="async"></span>
					<span><small>bez brige! · sada</small><b>{{ push.title }}</b>{{ push.body }}</span>
				</div>
			</div>
		</div>

		{# The client's awareness level, climbing as the agent works. #}
		<ol class="m-lead-flow__ladder">
			{% for level in 4..0 %}<li><b>{{ level }}</b>{{ awareness[level] }}</li>{% endfor %}
		</ol>
	</div>
</div>
