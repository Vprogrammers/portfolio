{# A deck of product cards swiped across the slide: right with a LIKE stamp into the bag, left with NOPE, the next card rising each time, then the bill. Products are drawn as silhouettes. Fills its positioned parent. #}
{% set shapes = {
	sneaker: '<path d="M18 92c0-10 6-18 16-20l30-6c8-2 14-10 18-18l6-12c2-4 8-6 12-2l16 18c8 9 20 14 32 14h18c12 0 22 10 22 22v4H18z"/><path class="m-swipe-deck__sole" d="M14 96h174v10c0 4-3 7-7 7H24c-6 0-10-5-10-10z"/><path class="m-swipe-deck__lace" d="M86 52l14 10M80 62l14 10M74 72l12 8"/>',
	boot: '<path d="M70 14h46l2 64c0 8 6 14 14 16l28 6c10 2 18 10 18 20v4H64z"/><path class="m-swipe-deck__sole" d="M60 122h120v8c0 3-2 5-5 5H66c-3 0-6-3-6-6z"/><path class="m-swipe-deck__lace" d="M80 30h26M80 44h26M80 58h26"/>',
	heel: '<path d="M30 70c10-14 26-20 40-14l50 26c14 7 30 10 46 10h12c6 0 10 4 10 10v6H118c-12 0-22-6-30-14L66 74c-6-6-16-6-22 0l-4 4c-4 4-10 4-12 0z"/><path class="m-swipe-deck__sole" d="M36 78l10 46h8l-4-40z"/>',
	bag: '<path class="m-swipe-deck__lace" d="M72 56c0-24 12-38 28-38s28 14 28 38" fill="none" stroke-width="7"/><path d="M40 54h120l12 74c1 6-4 12-10 12H38c-6 0-11-6-10-12z"/><path class="m-swipe-deck__sole" d="M84 82h32v14H84z"/>'
} %}
<div class="m-swipe-deck" aria-hidden="true">
	<div class="m-swipe-deck__stage">
		<p class="m-swipe-deck__bag-count"><i></i>{{ bag }}<b>{% for n in 1..3 %}<em>{{ n }}</em>{% endfor %}</b></p>

		<div class="m-swipe-deck__deck">
			{# Last product first in the DOM, so the first one sits on top. #}
			{% for i in products|length..1 %}
				{% set product = products[i - 1] %}
				<div class="m-swipe-deck__card m-swipe-deck__card--{{ i }}" style="--hue: {{ product.hue }}">
					<div class="m-swipe-deck__photo"><svg viewBox="0 0 200 150">{{ shapes[product.shape]|raw }}</svg></div>
					<p class="m-swipe-deck__name">{{ product.name }}<b>{{ product.price }}</b></p>
					<p class="m-swipe-deck__sizes">{% for size in product.sizes %}<span>{{ size }}</span>{% endfor %}</p>
					<em class="m-swipe-deck__stamp m-swipe-deck__stamp--like">LIKE</em>
					<em class="m-swipe-deck__stamp m-swipe-deck__stamp--nope">NOPE</em>
				</div>
			{% endfor %}
		</div>

		<p class="m-swipe-deck__actions"><span class="m-swipe-deck__nope">✕</span><span class="m-swipe-deck__like">♥</span></p>

		<div class="m-swipe-deck__bill">
			<p class="m-swipe-deck__bill-title">{{ bill.title }}</p>
			{% for product in products %}{% if product.like %}<p class="m-swipe-deck__line"><span>{{ product.name }}</span><b>{{ product.price }}</b></p>{% endif %}{% endfor %}
			<p class="m-swipe-deck__total"><span>Total</span><b>{{ bill.total }}</b></p>
			<span class="m-swipe-deck__checkout">Checkout</span>
		</div>
	</div>
</div>
