{# A project case study: hero (the project's animated scene from the home page, or an image) with key facts, the brief, contributions, and optional screens, findings, layers, stack, team and result, then a call to action and the next case study. Data per project lives in src/views/_data/work/<project>.json. #}
<article class="o-case-study" id="top">
	{# "device" scenes cover the hero like the home slide; the others stand in a panel beside the copy. #}
	<header class="o-case-study__hero{% if scene and sceneType != 'device' %} o-case-study__hero--panel{% endif %}">
		{% if scene %}
			<div class="o-case-study__hero-scene">
				{# Nitro needs each pattern name written out. #}
				{% if sceneType == 'device' %}
					{% pattern name='device-scene' data=scene|merge({ priority: true }) %}
				{% elseif sceneType == 'phone' %}
					{% pattern name='phone-scroll' data=scene|merge({ priority: true }) %}
				{% elseif sceneType == 'laptop' %}
					{% pattern name='laptop-scroll' data=scene|merge({ priority: true }) %}
				{% elseif sceneType == 'web' %}
					{% pattern name='web-wrap' data=scene %}
				{% elseif sceneType == 'scan' %}
					{% pattern name='scan-view' data=scene %}
				{% elseif sceneType == 'review' %}
					{% pattern name='code-review' data=scene %}
				{% elseif sceneType == 'tokens' %}
					{% pattern name='token-flow' data=scene %}
				{% elseif sceneType == 'sdui' %}
					{% pattern name='sdui-live' data=scene %}
				{% elseif sceneType == 'mvi' %}
					{% pattern name='mvi-loop' data=scene %}
				{% elseif sceneType == 'kit' %}
					{% pattern name='kmp-stack' data=scene %}
				{% endif %}
			</div>
		{% elseif hero %}
			<img class="o-case-study__hero-image" src="{{ hero }}" alt="" fetchpriority="high" decoding="async">
		{% endif %}
		<div class="o-case-study__hero-content">
			<a class="o-case-study__back" href="{{ back.url }}"><span aria-hidden="true">←</span> {{ back.label }}</a>
			<p class="o-case-study__kicker">{{ kicker }}</p>
			<h1 class="o-case-study__title">{{ title }}</h1>
			<p class="o-case-study__lead">{{ lead }}</p>
			{% if employer %}{% pattern name='employer' data=employers[employer] %}{% endif %}
		</div>
	</header>

	<div class="o-case-study__body">
		<dl class="o-case-study__facts">
			{% for fact in facts %}
				<div class="o-case-study__fact"><dt>{{ fact.label }}</dt><dd>{{ fact.value }}</dd></div>
			{% endfor %}
		</dl>

		<section class="o-case-study__split" aria-labelledby="case-brief">
			<div>
				<h2 class="o-case-study__heading" id="case-brief">{{ brief.title }}</h2>
				{% for paragraph in brief.text %}<p class="o-case-study__text">{{ paragraph }}</p>{% endfor %}
			</div>
			<div>
				<h2 class="o-case-study__heading">{{ contributions.title }}</h2>
				<ul class="o-case-study__list">
					{% for item in contributions.items %}<li>{{ item }}</li>{% endfor %}
				</ul>
			</div>
		</section>
	</div>

	{% if screens %}
		<section class="o-case-study__screens" aria-labelledby="case-screens">
			<h2 class="o-case-study__heading o-case-study__heading--inset" id="case-screens">{{ screens.title }}</h2>
			{# Scrolls sideways; focusable so keyboard users can scroll it with the arrow keys. #}
			<ul class="o-case-study__gallery" tabindex="0" aria-label="{{ screens.title }}, scrolls sideways">
				{% for screen in screens.items %}
					<li class="o-case-study__screen">
						<figure>
							<div class="o-case-study__device"><img src="{{ screen.src }}" alt="{{ screen.caption }}" loading="lazy" decoding="async"></div>
							<figcaption>{{ screen.caption }}</figcaption>
						</figure>
					</li>
				{% endfor %}
			</ul>
		</section>
	{% endif %}

	<div class="o-case-study__body">
		{% if findings %}
			<section aria-labelledby="case-findings">
				<h2 class="o-case-study__heading" id="case-findings">{{ findings.title }}</h2>
				{% if findings.text %}<p class="o-case-study__text o-case-study__text--narrow">{{ findings.text }}</p>{% endif %}
				<ul class="o-case-study__findings">
					{% for item in findings.items %}
						<li class="o-case-study__finding">
							{% if item.tag %}<span class="o-case-study__tag">{{ item.tag }}</span>{% endif %}
							<h3>{{ item.title }}</h3>
							<p>{{ item.text }}</p>
						</li>
					{% endfor %}
				</ul>
			</section>
		{% endif %}

		{% if architecture %}
			<section aria-labelledby="case-architecture">
				<h2 class="o-case-study__heading" id="case-architecture">{{ architecture.title }}</h2>
				{% if architecture.text %}<p class="o-case-study__text o-case-study__text--narrow">{{ architecture.text }}</p>{% endif %}
				<ol class="o-case-study__layers">
					{% for layer in architecture.layers %}
						<li class="o-case-study__layer o-case-study__layer--{{ loop.index }}">
							<h3>{{ layer.name }}</h3>
							<ul>{% for item in layer.items %}<li>{{ item }}</li>{% endfor %}</ul>
						</li>
					{% endfor %}
				</ol>
			</section>
		{% endif %}

		<section class="o-case-study__split" aria-labelledby="case-team">
			<div>
				<h2 class="o-case-study__heading">{{ stack.title }}</h2>
				<ul class="o-case-study__chips">
					{% for item in stack.items %}<li>{{ item }}</li>{% endfor %}
				</ul>
			</div>
			<div>
				<h2 class="o-case-study__heading" id="case-team">{{ team.title }}</h2>
				<p class="o-case-study__text">{{ team.text }}</p>
				{% if team.items %}
					<dl class="o-case-study__numbers">
						{% for item in team.items %}<div><dt>{{ item[1] }}</dt><dd>{{ item[0] }}</dd></div>{% endfor %}
					</dl>
				{% endif %}
			</div>
		</section>

		<section aria-labelledby="case-outcome">
			<h2 class="o-case-study__heading" id="case-outcome">{{ outcome.title }}</h2>
			<p class="o-case-study__text o-case-study__text--large">{{ outcome.text }}</p>
		</section>

		<aside class="o-case-study__cta">
			<h2 class="o-case-study__cta-title">{{ cta.title }}</h2>
			<p class="o-case-study__text">{{ cta.text }}</p>
			<p class="o-case-study__actions">
				<a class="o-case-study__button" href="{{ cta.url }}">{{ cta.label }}</a>
				<a class="o-case-study__button o-case-study__button--ghost" href="{{ back.url }}">{{ back.label }}</a>
			</p>
		</aside>

		{% if next %}
			<a class="o-case-study__next" href="{{ next.url }}">
				<span class="o-case-study__next-label">Next case study</span>
				<span class="o-case-study__next-title">{{ next.title }} <span aria-hidden="true">→</span></span>
			</a>
		{% endif %}
	</div>
</article>
