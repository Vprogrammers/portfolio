{# Edge-to-edge project tiles; details appear on hover or focus. #}
<section class="o-project-grid" id="{{ id|default('works') }}" aria-labelledby="{{ id|default('works') }}-title">
	<h2 class="o-project-grid__heading" id="{{ id|default('works') }}-title">Works</h2>
	<ul class="o-project-grid__list">
		{% for project in projects %}
			{% if project.grid is not same as(false) %}
				<li class="o-project-grid__item" data-tone="{{ project.tone|default('teal') }}" {% if not project.frameSets and not project.frames and not project.radio and not project.crew and not project.web and not project.leads and not project.salon and not project.scan and not project.review and not project.deck and not project.fantasy and not project.pageant and not project.kids and not project.tokens and not project.sdui and not project.mvi and not project.kit and not project.club and not project.apples and not project.coins and not project.feniks and not project.pass and not project.club2 and not project.live and not project.laptop and not project.phone and not project.image %}data-media="none"{% endif %}>
					{# Tiles without a link are focusable themselves, so keyboard users can reveal the caption. #}
					<article class="o-project-grid__tile" {% if not project.url %}tabindex="0" aria-labelledby="project-{{ loop.index }}-title"{% endif %}>
						<div class="o-project-grid__media">
							{% if project.frameSets or project.frames %}
								{# A tile has no slide changes, so it plays every set back to back. #}
								{% set allFrames = [] %}
								{% for set in project.frameSets|default([project.frames]) %}{% set allFrames = allFrames|merge(set) %}{% endfor %}
								{% pattern name='device-scene' data=project|merge({ frameSets: [allFrames], priority: false }) %}
							{% elseif project.web %}
								{% pattern name='web-wrap' data=project.web %}
							{% elseif project.leads %}
								{% pattern name='lead-flow' data=project.leads %}
							{% elseif project.salon %}
								{% pattern name='salon-scene' data=project.salon %}
							{% elseif project.scan %}
								{% pattern name='scan-view' data=project.scan %}
							{% elseif project.review %}
								{% pattern name='code-review' data=project.review %}
							{% elseif project.deck %}
								{% pattern name='swipe-deck' data=project.deck %}
							{% elseif project.fantasy %}
								{% pattern name='fantasy-pitch' data=project.fantasy %}
							{% elseif project.pageant %}
								{% pattern name='pageant-stage' data=project.pageant %}
							{% elseif project.kids %}
								{% pattern name='kids-tv' data=project.kids %}
							{% elseif project.tokens %}
								{% pattern name='token-flow' data=project.tokens %}
							{% elseif project.sdui %}
								{% pattern name='sdui-live' data=project.sdui %}
							{% elseif project.mvi %}
								{% pattern name='mvi-loop' data=project.mvi %}
							{% elseif project.kit %}
								{% pattern name='kmp-stack' data=project.kit %}
							{% elseif project.club %}
								{% pattern name='club-floor' data=project.club %}
							{% elseif project.apples %}
								{% pattern name='apple-sort' data=project.apples %}
							{% elseif project.coins %}
								{% pattern name='coin-board' data=project.coins %}
							{% elseif project.feniks %}
								{% pattern name='freezer-case' data=project.feniks %}
							{% elseif project.pass %}
								{% pattern name='pass-card' data=project.pass %}
							{% elseif project.club2 %}
								{% pattern name='driver-club' data=project.club2 %}
							{% elseif project.crew %}
								{% pattern name='crew-call' data=project.crew %}
							{% elseif project.radio %}
								{% pattern name='on-air' data=project.radio %}
							{% elseif project.live %}
								{% pattern name='live-room' data=project.live %}
							{% elseif project.laptop %}
								{% pattern name='laptop-scroll' data=project.laptop|merge({ priority: false }) %}
							{% elseif project.phone %}
								{% pattern name='phone-scroll' data=project.phone|merge({ priority: false }) %}
							{% elseif project.image %}
								<img class="o-project-grid__image" src="{{ project.image }}" alt="" loading="lazy" decoding="async">
							{% endif %}
						</div>
						<div class="o-project-grid__caption">
							<h3 class="o-project-grid__title" id="project-{{ loop.index }}-title">
								{% if project.url %}
									<a class="o-project-grid__link" href="{{ project.url }}">{{ project.gridTitle|default(project.title) }}</a>
								{% else %}
									{{ project.gridTitle|default(project.title) }}
								{% endif %}
							</h3>
							<p class="o-project-grid__category">{{ project.category }}</p>
							{% if project.employer %}{% pattern name='employer' data=employers[project.employer] %}{% endif %}
							<p class="o-project-grid__summary">{{ project.summary }}</p>
						</div>
					</article>
				</li>
			{% endif %}
		{% endfor %}
	</ul>
</section>
