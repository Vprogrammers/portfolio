{# Featured project data is supplied by the page's static JSON context; "hero": false keeps a project out of the slider. #}
{% set heroProjects = [] %}
{% for project in projects %}
  {% if project.hero is not same as(false) %}{% set heroProjects = heroProjects|merge([project]) %}{% endif %}
{% endfor %}
<section class="o-project-player js-project-player" aria-label="Featured projects" data-interval="7000">
  {% if intro %}
    <div class="o-project-player__intro">
      <h1 class="o-project-player__name">{{ intro.name }}</h1>
      <p class="o-project-player__role">{{ intro.role }}</p>
    </div>
  {% endif %}
  <div class="o-project-player__slides">
    {% for project in heroProjects %}
      <article class="o-project-player__slide" data-project-slide data-tone="{{ project.tone|default('teal') }}" {% if project.variant %}data-scene="{{ project.variant }}"{% endif %} {% if project.duration %}data-duration="{{ project.duration }}"{% endif %} {% if project.staticBackground %}data-static-background="true"{% endif %} {% if not loop.first %}hidden{% endif %}>
        {% if project.frameSets or project.frames %}
          {% pattern name='device-scene' data=project|merge({ priority: loop.first }) %}
        {% elseif project.crew %}
          {% pattern name='crew-call' data=project.crew %}
        {% elseif project.radio %}
          {% pattern name='on-air' data=project.radio %}
        {% elseif project.live %}
          {% pattern name='live-room' data=project.live %}
        {% elseif project.laptop %}
          {% pattern name='laptop-scroll' data=project.laptop|merge({ priority: loop.first }) %}
        {% elseif project.phone %}
          {% pattern name='phone-scroll' data=project.phone|merge({ priority: loop.first }) %}
        {% elseif project.image %}
          <picture class="o-project-player__picture">
            {% if project.imageMobile %}<source media="(max-width: 575px)" srcset="{{ project.imageMobile }}">{% endif %}
            {% if project.imageTablet %}<source media="(min-width: 576px) and (max-width: 1023px)" srcset="{{ project.imageTablet }}">{% endif %}
            {% if project.imageWide %}<source media="(min-aspect-ratio: 2/1) and (min-width: 1024px)" srcset="{{ project.imageWide }}">{% endif %}
            <img class="o-project-player__background" src="{{ project.image }}" alt="" {% if loop.first %}fetchpriority="high"{% endif %} loading="eager" decoding="async">
          </picture>
        {% endif %}
        <div class="o-project-player__content">
          <p class="o-project-player__eyebrow">{{ project.category }}</p>
          <h2 class="o-project-player__title">{{ project.title }}</h2>
          <p class="o-project-player__description">{{ project.summary }}</p>
          {% if project.url %}
            <a class="o-project-player__link" href="{{ project.url }}">Explore {{ project.title }}</a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
  {% if heroProjects|length > 1 %}
    <div class="o-project-player__controls" role="group" aria-label="Project controls">
      <button type="button" data-project-prev aria-label="Previous project">Previous</button>
      <button type="button" data-project-toggle aria-label="Pause automatic project changes" aria-pressed="false">Pause</button>
      <button type="button" data-project-next aria-label="Next project">Next</button>
      <span class="o-project-player__progress" data-project-progress aria-hidden="true"></span>
    </div>
  {% endif %}
  {% if scrollTarget %}
    <a class="o-project-player__scroll" href="{{ scrollTarget }}">
      <span class="o-project-player__scroll-label">See all works</span>
      <svg viewBox="0 0 44 22" aria-hidden="true" focusable="false"><path d="M1 1l21 20L43 1" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
    </a>
  {% endif %}
</section>
