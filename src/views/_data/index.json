			"review": {
				"file": "AppDelegate.m",
				"reviewer": "VN",
				"findings": [
					{
						"severity": "Critical",
						"title": "AFNetworking pinned below 1.9",
						"body": "AFHTTPRequestOperation in 19 files, on a library that has had no support for years. Move networking to URLSession."
					},
					{
						"severity": "Major",
						"title": "ReactiveCocoa 2.5",
						"body": "The Objective-C version of RAC is unmaintained. Replace its signals with Combine or async/await step by step."
					},
					{
						"severity": "Major",
						"title": "Fabric is shut down",
						"body": "Crash reports still go through Fabric with CrashlyticsKit. Switch to Firebase Crashlytics."
					},
					{
						"severity": "Minor",
						"title": "Debug tools in release builds",
						"body": "PonyDebugger and the Reveal SDK are linked for every configuration. Limit them to Debug."
					},
					{
						"severity": "Minor",
						"title": "UIAlertView in 17 files",
						"body": "Deprecated since iOS 9. Replace with UIAlertController."
					},
					{
						"severity": "Info",
						"title": "No unit tests",
						"body": "There is no test target yet. Start with the sync and the data mapping before changing them."
					}
				],
				"summary": "Review done: a maintenance plan from the riskiest dependencies down."
			}
