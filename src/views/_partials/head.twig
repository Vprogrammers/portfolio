<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# Each page's JSON sets meta.description and meta.path; the site address is fixed below. #}
{% set siteUrl = 'https://vprogrammers.me' %}
{% set description = meta.description|default('Viktor Nešić, senior mobile engineer: native iOS, Android and Kotlin Multiplatform apps, from enterprise products to MVPs.') %}
<meta name="description" content="{{ description }}">
{% if meta.noindex %}<meta name="robots" content="noindex">{% else %}<link rel="canonical" href="{{ siteUrl }}{{ meta.path|default('/') }}">{% endif %}
<link rel="icon" href="/assets/img/icon/favicon.ico" sizes="32x32">
<link rel="icon" href="/assets/img/icon/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/icon/apple-touch-icon.png">
<link rel="manifest" href="/assets/img/icon/site.webmanifest">
<meta name="theme-color" content="#0b0f17">
<title>{{ _nitro.pageTitle }}</title>
<meta name="format-detection" content="telephone=no">
{# Link previews on LinkedIn, Slack and other sites. #}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Viktor Nešić">
<meta property="og:title" content="{{ _nitro.pageTitle }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ siteUrl }}{{ meta.path|default('/') }}">
<meta property="og:image" content="{{ siteUrl }}/assets/img/og-image.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
{# Structured data (schema.org) from the page JSON: who I am and what each page is about, for search engines and AI assistants. #}
{% if structuredData %}<script type="application/ld+json">{{ structuredData|json_encode|raw }}</script>{% endif %}
<link href="/assets/css/ui{% if _nitro.production %}.min{% endif %}.css" rel="stylesheet">
{% if not _nitro.production %}<script defer src="/assets/js/runtime.js"></script>{% endif %}
<script defer src="/assets/js/vendors{% if _nitro.production %}.min{% endif %}.js"></script>
<script defer src="/assets/js/ui{% if _nitro.production %}.min{% endif %}.js"></script>
{# Visitor statistics with Google Analytics 4 (Firebase Analytics), only on the built site and once a measurement ID is set.
   Consent Mode starts denied: no cookies until the visitor accepts in the consent banner, which then grants analytics_storage. #}
{% if analytics.gaMeasurementId and _nitro.production %}
<script>
window.dataLayer = window.dataLayer || [];
function gtag(){ dataLayer.push(arguments); }
gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
try { if (localStorage.getItem('analytics-consent') === 'granted') gtag('consent', 'update', { analytics_storage: 'granted' }); } catch (e) {}
gtag('js', new Date());
gtag('config', '{{ analytics.gaMeasurementId }}', { anonymize_ip: true });
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id={{ analytics.gaMeasurementId }}"></script>
{% endif %}
