<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Nitro - {{ _nitro.pageTitle }}">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/assets/img/icon/favicon.ico" sizes="any">
<link rel="icon" href="/assets/img/icon/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/icon/apple-touch-icon.png">
<link rel="manifest" href="/assets/img/icon/site.webmanifest">
<meta name="msapplication-config" content="none">
<meta name="theme-color" content="#fafafa">
<title>{{ _nitro.pageTitle }}</title>
<meta name="format-detection" content="telephone=no">
<link href="/assets/css/ui{% if _nitro.production %}.min{% endif %}.css" rel="stylesheet">
{% if not _nitro.test %}<link href="/assets/css/proto{% if _nitro.production %}.min{% endif %}.css" rel="stylesheet">{% endif %}
{% if not _nitro.production %}<script defer src="/assets/js/runtime.js"></script>{% endif %}
<script defer src="/assets/js/vendors{% if _nitro.production %}.min{% endif %}.js"></script>
<script defer src="/assets/js/ui{% if _nitro.production %}.min{% endif %}.js"></script>
{% if not _nitro.test %}<script defer src="/assets/js/proto{% if _nitro.production %}.min{% endif %}.js"></script>{% endif %}
{# Visitor statistics with Google Analytics 4 (Firebase Analytics), only on the built site and once a measurement ID is set.
   Consent Mode starts denied: no cookies until the visitor accepts in the consent banner, which then grants analytics_storage. #}
{% if analytics.gaMeasurementId and _nitro.production %}
<script>
window.dataLayer = window.dataLayer || [];
function gtag(){ dataLayer.push(arguments); }
gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
try { if (localStorage.getItem('analytics-consent') === 'granted') gtag('consent', 'update', { analytics_storage: 'granted' }); } catch (e) {}
gtag('js', new Date());
gtag('config', '{{ analytics.gaMeasurementId }}', { anonymize_ip: true });
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id={{ analytics.gaMeasurementId }}"></script>
{% endif %}
